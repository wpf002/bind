DATABASE_URL="postgresql://willfoti@localhost:5432/bind?schema=public"
# API tests write to bind_test on the same server. Set this to use another server; the database must be named bind_test.
# TEST_DATABASE_URL=""
API_PORT=4300
NEXT_PUBLIC_API_URL="http://127.0.0.1:4300"
NODE_ENV="development"
# Local review only. Shows held drafts. Never set to 1 where the site is public.
BIND_PREVIEW_DRAFTS="0"

# Adversarial audit (Phase 4). Any OpenAI-compatible endpoint. Must not be a Claude model.
AUDIT_API_BASE=""
AUDIT_API_KEY=""
AUDIT_MODEL=""

# Second auditor. Run with AUDIT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# and AUDIT_API_KEY="$GEMINI_API_KEY". Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Review queue (Phase 7). "name:token,name:token", two or more reviewers, tokens of 32+ characters.
# Generate a token with: openssl rand -hex 24. Leave empty to turn the queue off.
REVIEWERS=""
