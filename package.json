{
  "name": "bind",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @bind/db exec prisma db push",
    "db:generate": "pnpm --filter @bind/db exec prisma generate",
    "db:studio": "pnpm --filter @bind/db exec prisma studio",
    "db:seed": "pnpm --filter @bind/db run seed",
    "corpus:export": "pnpm --filter @bind/db run export"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.9.0",
    "eslint": "10.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^2.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
